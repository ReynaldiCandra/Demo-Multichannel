# ── Database (Supabase) ───────────────────────────────────────────────────────
# Project Settings → Database → Connection string → URI
# Aplikasi: Transaction pooler (port 6543)
DATABASE_URL="postgresql://postgres.xzrqqulehltbikvcmejo:Amandadesti378@aws-0-ap-south-1.pooler.supabase.com:6543/postgres"
DIRECT_URL="postgresql://postgres.xzrqqulehltbikvcmejo:Amandadesti378@aws-0-ap-south-1.pooler.supabase.com:5432/postgres"

# ── Penyimpanan foto produk (Vercel Blob) ─────────────────────────────────────
# Buat Blob store di Vercel, lalu salin token read/write ke environment Vercel.
BLOB_READ_WRITE_TOKEN=""

# ── Autentikasi ───────────────────────────────────────────────────────────────
# WAJIB. Minimal 32 karakter. Buat dengan: openssl rand -base64 32
# Kalau diganti, semua sesi login yang sedang aktif langsung logout.
AUTH_SECRET=""

# ── Akun awal (hanya dipakai saat `npm run db:seed`) ──────────────────────────
SEED_OWNER_EMAIL="owner@websensial.com"
SEED_OWNER_PASSWORD=""
SEED_DEMO_PASSWORD="demo1234"

# Isi "false" kalau mau mulai dari database kosong tanpa data contoh.
SEED_SAMPLE_DATA="true"
